DB_SUPABASE_URL=
DB_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (Supabase > Project Settings > API Keys > secret). Never expose it to the browser.
DB_SUPABASE_SECRET_KEY=
DB_PASSWORD=
# Optional: Supabase session pooler string, needed by `npm run db:migrate` on IPv4-only networks
DATABASE_URL=
# Public URL of the frontend: used for invite links and allowed by CORS
WEB_ORIGIN=http://localhost:3000
# Optional extra CORS origins, comma separated (e.g. preview deployments)
CORS_ORIGINS=
PORT=4000
